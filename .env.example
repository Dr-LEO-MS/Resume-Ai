# ---------------------------------------------------------------------------
# Resume AI environment template. Copy to .env (which is gitignored) and fill in.
# Do NOT commit .env - it contains secrets.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Postgres connection string from Neon / Supabase / Render.
# Example (Neon):   postgresql://user:password@ep-xxxx-yyyy-pooler.region.aws.neon.tech/dbname?sslmode=require
# Example (Render): postgresql://user:password@host:5432/dbname
DATABASE_URL=

# --- Auth -------------------------------------------------------------------
# Long random string. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# --- Default super-admin seed (used on first ever startup) --------------------
ADMIN_EMAIL=admin@resumeai.com
ADMIN_PASSWORD=ChangeMe!StrongPass123

# --- AI providers (optional; AI falls back to offline mock without these) ----
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# AI_PROVIDER=anthropic   # anthropic | openai | deepseek
# AI_MODEL=claude-sonnet-4-6
